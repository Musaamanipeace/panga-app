--- /dev/null
+++ b/src/voice/eligibility.ts
@@ -0,0 +1,29 @@
+import type { DictationTarget } from "./insertText";
+
+const DICTATABLE_INPUT_TYPES = new Set(["text", "search"]);
+
+// Fields that hold secrets or structured values: never dictate into these.
+const SENSITIVE_HINT =
+  /pass(word|wd)\b|token|secret|api[-_ ]?key|client[-_ ]?id|\botp\b|one-time|credit[-_ ]?card|\bcvv\b|\biban\b|\bssn\b/i;
+
+/**
+ * True when voice dictation should be offered for this element: plain text
+ * inputs and textareas only. Opt a field out with data-no-voice (on the field
+ * or any ancestor).
+ */
+export function isDictatable(el: EventTarget | Element | null): el is DictationTarget {
+  if (!el) return false;
+  const isTextarea = el instanceof HTMLTextAreaElement;
+  if (!isTextarea) {
+    if (!(el instanceof HTMLInputElement)) return false;
+    const type = (el.getAttribute("type") || "text").toLowerCase();
+    if (!DICTATABLE_INPUT_TYPES.has(type)) return false;
+  }
+  const field = el as DictationTarget;
+  if (field.disabled || field.readOnly) return false;
+  if (field.closest("[data-no-voice]")) return false;
+  const hint = [field.name, field.id, field.getAttribute("autocomplete"), field.getAttribute("aria-label"), field.placeholder]
+    .filter(Boolean)
+    .join(" ");
+  return !SENSITIVE_HINT.test(hint);
+}
diff --git a/src/voice/engines/browserSpeech.ts b/src/voice/engines/browserSpeech.ts
new file mode 100644
index 0000000..881a191
--- /dev/null
+++ b/src/voice/engines/browserSpeech.ts
@@ -0,0 +1,100 @@
+import { LANGUAGES } from "../models";
+import type { EngineEvents, EngineOptions, VoiceEngine } from "../types";
+
+function getCtor(): any {
+  const w = window as any;
+  return w.SpeechRecognition || w.webkitSpeechRecognition;
+}
+
+export function isBrowserSpeechSupported(): boolean {
+  return typeof window !== "undefined" && !!getCtor();
+}
+
+function browserLang(code: string): string {
+  if (code === "en" && typeof navigator !== "undefined" && /^en/i.test(navigator.language)) {
+    return navigator.language;
+  }
+  return LANGUAGES.find((l) => l.code === code)?.browser ?? "en-US";
+}
+
+/**
+ * The browser's built-in recognizer. Gives live words as you speak, but the
+ * browser (Chrome/Edge/Safari) sends audio to its vendor's servers, so it needs
+ * an internet connection and is not private.
+ */
+export function createBrowserSpeechEngine(): VoiceEngine {
+  let recognition: any = null;
+  let active = false;
+
+  return {
+    id: "browser",
+
+    async start(ev: EngineEvents, options: EngineOptions) {
+      const Ctor = getCtor();
+      if (!Ctor) throw new Error("This browser has no built-in speech recognition.");
+      active = true;
+      const rec = new Ctor();
+      rec.continuous = true;
+      rec.interimResults = true;
+      rec.lang = browserLang(options.lang);
+
+      rec.onstart = () => ev.onStatus({ kind: "listening" });
+      rec.onresult = (event: any) => {
+        let interim = "";
+        for (let i = event.resultIndex; i < event.results.length; i++) {
+          const r = event.results[i];
+          const text: string = r[0].transcript;
+          if (r.isFinal) {
+            const t = text.trim();
+            if (t) ev.onFinal(t);
+            interim = "";
+          } else {
+            interim += text;
+          }
+        }
+        ev.onInterim(interim.trim());
+      };
+      rec.onerror = (event: any) => {
+        const code: string = event.error;
+        if (code === "no-speech" || code === "aborted") return;
+        active = false;
+        if (code === "not-allowed" || code === "service-not-allowed") {
+          ev.onError("Microphone access was blocked. Allow it in your browser's site settings.");
+        } else if (code === "network") {
+          ev.onError("Browser speech recognition needs an internet connection. Switch to offline mode in Settings.");
+        } else {
+          ev.onError(`Speech recognition error: ${code}`);
+        }
+      };
+      rec.onend = () => {
+        if (active) {
+          // Browsers end a session after a pause; keep dictation going.
+          setTimeout(() => {
+            if (!active) return;
+            try {
+              rec.start();
+            } catch {
+              active = false;
+              ev.onStatus({ kind: "idle" });
+            }
+          }, 150);
+        } else {
+          ev.onStatus({ kind: "idle" });
+        }
+      };
+
+      recognition = rec;
+      rec.start();
+    },
+
+    async stop() {
+      active = false;
+      try {
+        recognition?.stop();
+      } catch {
+        /* not running */
+      }
+      recognition = null;
+    },
+  };
+}
diff --git a/src/voice/engines/index.ts b/src/voice/engines/index.ts
new file mode 100644
index 0000000..0ed76cb
--- /dev/null
+++ b/src/voice/engines/index.ts
@@ -0,0 +1,28 @@
+import type { EngineId, VoiceEngine } from "../types";
+import { createBrowserSpeechEngine, isBrowserSpeechSupported } from "./browserSpeech";
+import { createLocalWhisperEngine, isLocalWhisperSupported } from "./localWhisper";
+import { createServerWhisperEngine, isServerEngineSupported } from "./serverWhisper";
+
+export { probeServerEngine } from "./serverWhisper";
+
+export function isEngineSupported(id: EngineId): boolean {
+  if (id === "local") return isLocalWhisperSupported();
+  if (id === "browser") return isBrowserSpeechSupported();
+  return isServerEngineSupported();
+}
+
+export function createEngine(id: EngineId): VoiceEngine {
+  if (id === "local") return createLocalWhisperEngine();
+  if (id === "browser") return createBrowserSpeechEngine();
+  return createServerWhisperEngine();
+}
+
+/**
+ * The engine to use: the user's choice if this device supports it, otherwise
+ * the first one that works (offline first, then browser, then server).
+ */
+export function resolveEngineId(preferred: EngineId): EngineId | null {
+  if (isEngineSupported(preferred)) return preferred;
+  const order: EngineId[] = ["local", "browser", "server"];
+  return order.find((id) => id !== preferred && isEngineSupported(id)) ?? null;
+}
diff --git a/src/voice/engines/localWhisper.ts b/src/voice/engines/localWhisper.ts
new file mode 100644
index 0000000..e36d38f
--- /dev/null
+++ b/src/voice/engines/localWhisper.ts
@@ -0,0 +1,189 @@
+import { WHISPER_MODELS, LANGUAGES, type WhisperModelKey } from "../models";
+import { startSegmentedCapture, isCaptureSupported, type CaptureHandle } from "../audio";
+import { cleanTranscript } from "../transcript";
+import { markModelReady, getVoicePrefs } from "../prefs";
+import type { EngineEvents, EngineOptions, VoiceEngine } from "../types";
+
+const IDLE_TERMINATE_MS = 5 * 60 * 1000;
+
+type Progress = (fraction: number | null) => void;
+
+/** Owns the Whisper web worker: loads a model once, then transcribes phrases. */
+class WhisperClient {
+  private worker: Worker | null = null;
+  private loadedRepo = "";
+  private nextId = 1;
+  private pending = new Map<number, { resolve(t: string): void; reject(e: Error): void }>();
+  private loadWaiter: { resolve(): void; reject(e: Error): void } | null = null;
+  private files = new Map<string, { loaded: number; total: number }>();
+  private onProgress: Progress | null = null;
+  private idleTimer: ReturnType<typeof setTimeout> | null = null;
+
+  private ensureWorker(): Worker {
+    if (this.worker) return this.worker;
+    const w = new Worker(new URL("./whisper.worker.ts", import.meta.url), { type: "module" });
+    w.onmessage = (e: MessageEvent) => this.onMessage(e.data);
+    w.onerror = (e) => this.failAll(new Error(e.message || "Speech worker crashed"));
+    this.worker = w;
+    return w;
+  }
+
+  private onMessage(m: any) {
+    if (m.type === "progress") {
+      const p = m.p ?? {};
+      if (p.status === "progress" && p.file && typeof p.total === "number") {
+        this.files.set(p.file, { loaded: p.loaded ?? 0, total: p.total });
+        let loaded = 0;
+        let total = 0;
+        this.files.forEach((f) => {
+          loaded += f.loaded;
+          total += f.total;
+        });
+        this.onProgress?.(total > 0 ? Math.min(1, loaded / total) : null);
+      }
+    } else if (m.type === "ready") {
+      this.loadWaiter?.resolve();
+      this.loadWaiter = null;
+    } else if (m.type === "result") {
+      this.pending.get(m.id)?.resolve(m.text ?? "");
+      this.pending.delete(m.id);
+    } else if (m.type === "error") {
+      const err = new Error(m.message || "Speech recognition failed");
+      if (m.id !== undefined && this.pending.has(m.id)) {
+        this.pending.get(m.id)!.reject(err);
+        this.pending.delete(m.id);
+      } else {
+        this.loadWaiter?.reject(err);
+        this.loadWaiter = null;
+      }
+    }
+  }
+
+  private failAll(err: Error) {
+    this.loadWaiter?.reject(err);
+    this.loadWaiter = null;
+    this.pending.forEach((p) => p.reject(err));
+    this.pending.clear();
+    this.dispose();
+  }
+
+  load(model: WhisperModelKey, onProgress: Progress): Promise<void> {
+    const repo = WHISPER_MODELS[model].repo;
+    this.touch();
+    if (this.worker && this.loadedRepo === repo) return Promise.resolve();
+    this.files.clear();
+    this.onProgress = onProgress;
+    const w = this.ensureWorker();
+    return new Promise<void>((resolve, reject) => {
+      this.loadWaiter = {
+        resolve: () => {
+          this.loadedRepo = repo;
+          markModelReady(model);
+          resolve();
+        },
+        reject,
+      };
+      w.postMessage({ type: "load", repo });
+    });
+  }
+
+  transcribe(pcm: Float32Array, language?: string): Promise<string> {
+    this.touch();
+    const w = this.ensureWorker();
+    const id = this.nextId++;
+    return new Promise<string>((resolve, reject) => {
+      this.pending.set(id, { resolve, reject });
+      w.postMessage({ type: "transcribe", id, audio: pcm, language }, [pcm.buffer]);
+    });
+  }
+
+  /** Free the model's memory after a few idle minutes; reloading from cache is fast. */
+  private touch() {
+    if (this.idleTimer) clearTimeout(this.idleTimer);
+    this.idleTimer = setTimeout(() => this.dispose(), IDLE_TERMINATE_MS);
+  }
+
+  dispose() {
+    if (this.idleTimer) clearTimeout(this.idleTimer);
+    this.idleTimer = null;
+    this.worker?.terminate();
+    this.worker = null;
+    this.loadedRepo = "";
+  }
+}
+
+const client = new WhisperClient();
+
+/** Downloads a model ahead of time so dictation works offline later. */
+export function preloadWhisperModel(model: WhisperModelKey, onProgress: Progress): Promise<void> {
+  return client.load(model, onProgress);
+}
+
+export function isLocalWhisperSupported(): boolean {
+  return (
+    typeof Worker !== "undefined" &&
+    typeof WebAssembly !== "undefined" &&
+    typeof indexedDB !== "undefined" &&
+    isCaptureSupported()
+  );
+}
+
+export function createLocalWhisperEngine(): VoiceEngine {
+  let capture: CaptureHandle | null = null;
+  let queue: Promise<void> = Promise.resolve();
+  let inflight = 0;
+  let events: EngineEvents | null = null;
+  let stopped = true;
+
+  return {
+    id: "local",
+
+    async start(ev: EngineEvents, options: EngineOptions) {
+      events = ev;
+      stopped = false;
+      const { model } = getVoicePrefs();
+      const spec = WHISPER_MODELS[model];
+      const language = spec.multilingual
+        ? LANGUAGES.find((l) => l.code === options.lang)?.whisper
+        : undefined;
+
+      ev.onStatus({ kind: "loading", progress: null });
+      await client.load(model, (p) => {
+        if (!stopped) ev.onStatus({ kind: "loading", progress: p });
+      });
+      if (stopped) return;
+
+      capture = await startSegmentedCapture({
+        onSegment(pcm) {
+          inflight++;
+          events?.onStatus({ kind: "transcribing" });
+          queue = queue.then(async () => {
+            try {
+              const text = cleanTranscript(await client.transcribe(pcm, language));
+              if (text) events?.onFinal(text);
+            } catch (err) {
+              events?.onError(err instanceof Error ? err.message : "Transcription failed");
+            } finally {
+              inflight--;
+              if (inflight === 0) events?.onStatus(stopped ? { kind: "idle" } : { kind: "listening" });
+            }
+          });
+        },
+      });
+      if (stopped) {
+        capture.stop();
+        capture = null;
+        return;
+      }
+      ev.onStatus({ kind: "listening" });
+    },
+
+    async stop() {
+      stopped = true;
+      capture?.stop(); // flushes the phrase in progress into the queue
+      capture = null;
+      await queue;
+      events?.onStatus({ kind: "idle" });
+    },
+  };
+}
diff --git a/src/voice/engines/serverWhisper.ts b/src/voice/engines/serverWhisper.ts
new file mode 100644
index 0000000..a17e734
--- /dev/null
+++ b/src/voice/engines/serverWhisper.ts
@@ -0,0 +1,81 @@
+import { startSegmentedCapture, isCaptureSupported, type CaptureHandle } from "../audio";
+import { cleanTranscript } from "../transcript";
+import { encodeWav } from "../wav";
+import type { EngineEvents, EngineOptions, VoiceEngine } from "../types";
+
+let serverKnown: boolean | null = null;
+
+/** Asks the Panga server whether a transcription backend is configured. */
+export async function probeServerEngine(): Promise<boolean> {
+  try {
+    const res = await fetch("/api/voice/config", { headers: { Accept: "application/json" } });
+    if (!res.ok || !(res.headers.get("content-type") || "").includes("application/json")) {
+      serverKnown = false;
+    } else {
+      const data = await res.json();
+      serverKnown = data?.serverTranscription === true;
+    }
+  } catch {
+    serverKnown = false;
+  }
+  return serverKnown;
+}
+
+export function isServerEngineSupported(): boolean {
+  return serverKnown === true && isCaptureSupported();
+}
+
+export function createServerWhisperEngine(): VoiceEngine {
+  let capture: CaptureHandle | null = null;
+  let queue: Promise<void> = Promise.resolve();
+  let inflight = 0;
+  let events: EngineEvents | null = null;
+  let stopped = true;
+
+  return {
+    id: "server",
+
+    async start(ev: EngineEvents, options: EngineOptions) {
+      events = ev;
+      stopped = false;
+      capture = await startSegmentedCapture({
+        onSegment(pcm) {
+          inflight++;
+          events?.onStatus({ kind: "transcribing" });
+          queue = queue.then(async () => {
+            try {
+              const res = await fetch(`/api/transcribe?language=${encodeURIComponent(options.lang)}`, {
+                method: "POST",
+                headers: { "Content-Type": "audio/wav" },
+                body: encodeWav(pcm),
+              });
+              const data = await res.json().catch(() => ({}));
+              if (!res.ok) throw new Error(data?.error || `Transcription server error (${res.status})`);
+              const text = cleanTranscript(String(data.text ?? ""));
+              if (text) events?.onFinal(text);
+            } catch (err) {
+              events?.onError(err instanceof Error ? err.message : "Transcription failed");
+            } finally {
+              inflight--;
+              if (inflight === 0) events?.onStatus(stopped ? { kind: "idle" } : { kind: "listening" });
+            }
+          });
+        },
+      });
+      if (stopped) {
+        capture.stop();
+        capture = null;
+        return;
+      }
+      ev.onStatus({ kind: "listening" });
+    },
+
+    async stop() {
+      stopped = true;
+      capture?.stop();
+      capture = null;
+      await queue;
+      events?.onStatus({ kind: "idle" });
+    },
+  };
+}

diff --git a/src/pwa/install.ts b/src/pwa/install.ts
new file mode 100644
index 0000000..025ce54
--- /dev/null
+++ b/src/pwa/install.ts
@@ -0,0 +1,119 @@
+import { useSyncExternalStore } from "react";
+import { showToast } from "../components/ui";
+
+interface BeforeInstallPromptEvent extends Event {
+  prompt(): Promise<void>;
+  userChoice: Promise<{ outcome: "accepted" | "dismissed" }>;
+}
+
+export type InstallPlatform = "ios" | "safari" | "firefox" | "android-firefox" | "chromium" | "other";
+
+export interface InstallState {
+  /** The browser has offered a one-tap install prompt we can trigger. */
+  canPrompt: boolean;
+  /** Running as an installed app right now, or installed during this session. */
+  installed: boolean;
+  platform: InstallPlatform;
+  /** Installing requires HTTPS (localhost counts as secure). */
+  secure: boolean;
+}
+
+export function detectPlatform(ua: string, maxTouchPoints = 0): InstallPlatform {
+  if (/iPad|iPhone|iPod/.test(ua) || (/Macintosh/.test(ua) && maxTouchPoints > 1)) return "ios";
+  if (/Firefox/.test(ua)) return /Android/.test(ua) ? "android-firefox" : "firefox";
+  if (/Chrome|Chromium|CriOS|Edg|OPR|SamsungBrowser/.test(ua)) return "chromium";
+  if (/Safari/.test(ua)) return "safari";
+  return "other";
+}
+
+function isStandalone(): boolean {
+  if (typeof window === "undefined") return false;
+  return (
+    window.matchMedia?.("(display-mode: standalone)").matches === true ||
+    (navigator as unknown as { standalone?: boolean }).standalone === true
+  );
+}
+
+let deferred: BeforeInstallPromptEvent | null = null;
+let installedThisSession = false;
+const listeners = new Set<() => void>();
+
+function compute(): InstallState {
+  return {
+    canPrompt: deferred !== null,
+    installed: installedThisSession || isStandalone(),
+    platform: typeof navigator === "undefined" ? "other" : detectPlatform(navigator.userAgent, navigator.maxTouchPoints),
+    secure: typeof window === "undefined" ? true : window.isSecureContext,
+  };
+}
+
+let snapshot = compute();
+function emit() {
+  snapshot = compute();
+  listeners.forEach((l) => l());
+}
+
+// Registered at module load (imported first in main.tsx) so we never miss the
+// browser's one-time install event by waiting for a component to mount.
+if (typeof window !== "undefined") {
+  window.addEventListener("beforeinstallprompt", (e) => {
+    e.preventDefault(); // suppress the mini-infobar; we show our own button
+    deferred = e as BeforeInstallPromptEvent;
+    emit();
+  });
+  window.addEventListener("appinstalled", () => {
+    deferred = null;
+    installedThisSession = true;
+    emit();
+    showToast("Panga installed! Find it in your apps, or pin it to your taskbar or home screen.", "success", 5000);
+  });
+  window.matchMedia?.("(display-mode: standalone)").addEventListener?.("change", emit);
+}
+
+function subscribe(cb: () => void) {
+  listeners.add(cb);
+  return () => listeners.delete(cb);
+}
+
+export function useInstallState(): InstallState {
+  return useSyncExternalStore(subscribe, () => snapshot, () => snapshot);
+}
+
+/** Shows the browser's install dialog. Returns the user's choice. */
+export async function promptInstall(): Promise<"accepted" | "dismissed" | "unavailable"> {
+  const evt = deferred;
+  if (!evt) return "unavailable";
+  deferred = null; // the event can only be used once
+  emit();
+  await evt.prompt();
+  const { outcome } = await evt.userChoice;
+  return outcome;
+}
+
+export function installInstructions(platform: InstallPlatform): string[] {
+  switch (platform) {
+    case "ios":
+      return [
+        "Tap the Share button (the square with an arrow) in your browser's toolbar.",
+        "Scroll down and tap “Add to Home Screen”.",
+        "Tap “Add”. Panga now opens like a normal app.",
+      ];
+    case "safari":
+      return ["In the menu bar, choose File → Add to Dock.", "Panga opens in its own window from your Dock."];
+    case "firefox":
+      return [
+        "Desktop Firefox can't install web apps.",
+        "Open Panga in Chrome or Edge to install it, or bookmark this page to come back quickly.",
+      ];
+    case "android-firefox":
+      return ["Open the ⋮ menu.", "Tap “Install” (or “Add to Home screen”)."];
+    case "chromium":
+      return [
+        "Open the browser menu (⋮ or …).",
+        "Chrome: choose “Install Panga” (or Cast, save and share → Install page as app). Edge: Apps → Install this site as an app.",
+        "On Android, choose “Install app” or “Add to Home screen”.",
+      ];
+    default:
+      return ["Open your browser's menu and look for “Install”, “Add to Home screen” or “Add to Dock”."];
+  }
+}
diff --git a/src/voice/VoiceProvider.tsx b/src/voice/VoiceProvider.tsx
new file mode 100644
index 0000000..d3fe552
--- /dev/null
+++ b/src/voice/VoiceProvider.tsx
@@ -0,0 +1,249 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import { createPortal } from "react-dom";
+import { isDictatable } from "./eligibility";
+import { insertAtCaret, type DictationTarget } from "./insertText";
+import { createEngine, probeServerEngine, resolveEngineId } from "./engines";
+import { useVoicePrefs } from "./prefs";
+import { WHISPER_MODELS } from "./models";
+import type { EngineEvents, EngineStatus, VoiceEngine } from "./types";
+
+interface Props {
+  children: ReactNode;
+  /** Tests only: use this engine instead of the user's configured one. */
+  testEngine?: VoiceEngine;
+}
+
+function friendlyError(e: unknown): string {
+  const name = (e as { name?: string })?.name;
+  if (name === "NotAllowedError" || name === "SecurityError") {
+    return "Microphone access was blocked. Allow it in your browser's site settings.";
+  }
+  if (name === "NotFoundError") return "No microphone was found.";
+  return e instanceof Error && e.message ? e.message : "Voice input failed.";
+}
+
+function useAnchorRect(el: HTMLElement | null): DOMRect | null {
+  const [rect, setRect] = useState<DOMRect | null>(null);
+  useLayoutEffect(() => {
+    if (!el) return;
+    let raf = 0;
+    const measure = () => setRect(el.getBoundingClientRect());
+    const schedule = () => {
+      cancelAnimationFrame(raf);
+      raf = requestAnimationFrame(measure);
+    };
+    measure();
+    window.addEventListener("scroll", schedule, true);
+    window.addEventListener("resize", schedule);
+    const ro = typeof ResizeObserver !== "undefined" ? new ResizeObserver(schedule) : null;
+    ro?.observe(el);
+    return () => {
+      cancelAnimationFrame(raf);
+      window.removeEventListener("scroll", schedule, true);
+      window.removeEventListener("resize", schedule);
+      ro?.disconnect();
+    };
+  }, [el]);
+  return el ? rect : null;
+}
+
+function MicIcon() {
+  return (
+    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+      <rect x="9" y="2" width="6" height="12" rx="3" />
+      <path d="M5 11a7 7 0 0 0 14 0" />
+      <line x1="12" y1="18" x2="12" y2="22" />
+    </svg>
+  );
+}
+
+/**
+ * Adds voice dictation to every text field in the app. A small mic appears
+ * next to whichever field is focused; dictated phrases are inserted at that
+ * field's caret and never overwrite existing text. Mount once, near the root.
+ */
+export default function VoiceProvider({ children, testEngine }: Props) {
+  const prefs = useVoicePrefs();
+  const [serverChecked, setServerChecked] = useState(false);
+  const [target, setTarget] = useState<DictationTarget | null>(null);
+  const [listening, setListening] = useState(false);
+  const [status, setStatus] = useState<EngineStatus>({ kind: "idle" });
+  const [interim, setInterim] = useState("");
+  const [error, setError] = useState<string | null>(null);
+
+  const listeningRef = useRef(false);
+  const engineRef = useRef<VoiceEngine | null>(null);
+  const targetRef = useRef<DictationTarget | null>(null);
+  const dictationTargetRef = useRef<DictationTarget | null>(null);
+  targetRef.current = target;
+
+  useEffect(() => {
+    if (testEngine) return;
+    void probeServerEngine().then(() => setServerChecked(true));
+  }, [testEngine]);
+
+  const engineId = useMemo(
+    () => (testEngine ? testEngine.id : resolveEngineId(prefs.engine)),
+    // serverChecked: re-resolve once we know whether a server engine exists.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [prefs.engine, serverChecked, testEngine],
+  );
+
+  const stopDictation = useCallback(async () => {
+    if (!listeningRef.current) return;
+    listeningRef.current = false;
+    setListening(false);
+    setInterim("");
+    const engine = engineRef.current;
+    engineRef.current = null;
+    try {
+      await engine?.stop(); // waits for already-spoken phrases to be inserted
+    } catch {
+      /* engine already stopped */
+    }
+    dictationTargetRef.current = null;
+    setStatus({ kind: "idle" });
+  }, []);
+
+  const startDictation = useCallback(async () => {
+    const el = targetRef.current;
+    if (!el || !engineId || listeningRef.current) return;
+    setError(null);
+    setInterim("");
+    const engine = testEngine ?? createEngine(engineId);
+    engineRef.current = engine;
+    dictationTargetRef.current = el;
+    listeningRef.current = true;
+    setListening(true);
+
+    const events: EngineEvents = {
+      onInterim: (t) => {
+        if (listeningRef.current) setInterim(t);
+      },
+      onFinal: (text) => {
+        const dest = dictationTargetRef.current;
+        if (dest && dest.isConnected) insertAtCaret(dest, text);
+        setInterim("");
+      },
+      onStatus: setStatus,
+      onError: (message) => {
+        setError(message);
+        void stopDictation();
+      },
+    };
+    try {
+      await engine.start(events, { lang: prefs.lang });
+    } catch (e) {
+      events.onError(friendlyError(e));
+    }
+  }, [engineId, testEngine, prefs.lang, stopDictation]);
+
+  const toggle = useCallback(() => {
+    if (listeningRef.current) void stopDictation();
+    else void startDictation();
+  }, [startDictation, stopDictation]);
+
+  // Follow focus: the mic attaches to the focused text field, and an active
+  // dictation moves with the caret when you click into another field.
+  useEffect(() => {
+    const inVoiceUi = (el: Element | null) => !!el?.closest?.("[data-voice-ui]");
+
+    const onFocusIn = (e: FocusEvent) => {
+      const t = e.target as Element | null;
+      if (isDictatable(t)) {
+        setTarget(t);
+        setError(null);
+        if (listeningRef.current) dictationTargetRef.current = t;
+      } else if (!inVoiceUi(t)) {
+        if (listeningRef.current) void stopDictation();
+        setTarget(null);
+      }
+    };
+    const onFocusOut = (e: FocusEvent) => {
+      if (listeningRef.current) return;
+      const next = e.relatedTarget as Element | null;
+      if (next && (isDictatable(next) || inVoiceUi(next))) return;
+      setTimeout(() => {
+        if (!listeningRef.current && !isDictatable(document.activeElement)) setTarget(null);
+      }, 150);
+    };
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key === "Escape" && listeningRef.current) {
+        void stopDictation();
+      } else if (e.altKey && e.shiftKey && e.code === "KeyM" && (targetRef.current || listeningRef.current)) {
+        e.preventDefault();
+        toggle();
+      }
+    };
+    const onVisibility = () => {
+      if (document.hidden && listeningRef.current) void stopDictation();
+    };
+
+    document.addEventListener("focusin", onFocusIn);
+    document.addEventListener("focusout", onFocusOut);
+    document.addEventListener("keydown", onKeyDown);
+    document.addEventListener("visibilitychange", onVisibility);
+    // A field may already be focused when we mount (e.g. autoFocus).
+    if (isDictatable(document.activeElement)) setTarget(document.activeElement);
+    return () => {
+      document.removeEventListener("focusin", onFocusIn);
+      document.removeEventListener("focusout", onFocusOut);
+      document.removeEventListener("keydown", onKeyDown);
+      document.removeEventListener("visibilitychange", onVisibility);
+    };
+  }, [stopDictation, toggle]);
+
+  useEffect(() => () => void stopDictation(), [stopDictation]);
+
+  const rect = useAnchorRect(target);
+
+  let label = "";
+  if (error) label = error;
+  else if (status.kind === "loading") {
+    const pct = status.progress === null ? "" : ` ${Math.round(status.progress * 100)}%`;
+    const first = engineId === "local" && !prefs.ready[prefs.model];
+    label = first
+      ? `Downloading speech model (~${WHISPER_MODELS[prefs.model].approxMb} MB, one time)…${pct}`
+      : `Loading speech model…${pct}`;
+  } else if (status.kind === "transcribing") label = "Transcribing…";
+  else if (listening && status.kind === "listening") label = interim || "Listening…";
+  else if (listening) label = "Starting…";
+
+  let overlay: ReactNode = null;
+  if (engineId && target && rect && rect.bottom >= 0 && rect.top <= window.innerHeight) {
+    const below = rect.top < 44;
+    const top = below ? rect.bottom + 6 : rect.top - 38;
+    const right = Math.max(4, window.innerWidth - rect.right);
+    const prevent = (e: { preventDefault(): void }) => e.preventDefault(); // keep focus (and caret) in the field
+    overlay = createPortal(
+      <div data-voice-ui className="voice-fab" style={{ top, right }} role="group" aria-label="Voice dictation">
+        {label && (
+          <span className={`voice-fab-label${error ? " voice-fab-error" : ""}`} role="status" aria-live="polite">
+            {label}
+          </span>
+        )}
+        <button
+          type="button"
+          tabIndex={-1}
+          className={`voice-fab-btn${listening ? " voice-fab-btn-on" : ""}`}
+          aria-pressed={listening}
+          aria-label={listening ? "Stop dictation" : "Start dictation"}
+          title={listening ? "Stop dictation (Esc)" : "Dictate into this field (Alt+Shift+M)"}
+          onPointerDown={prevent}
+          onMouseDown={prevent}
+          onClick={toggle}
+        >
+          <MicIcon />
+        </button>
+      </div>,
+      document.body,
+    );
+  }
+
+  return (
+    <>
+      {children}
+      {overlay}
+    </>
+  );
+}
diff --git a/src/voice/VoiceSettings.tsx b/src/voice/VoiceSettings.tsx
new file mode 100644
index 0000000..c08c429
--- /dev/null
+++ b/src/voice/VoiceSettings.tsx
@@ -0,0 +1,172 @@
+import { useEffect, useState } from "react";
+import { useVoicePrefs, setVoicePrefs } from "./prefs";
+import { WHISPER_MODELS, LANGUAGES, type WhisperModelKey } from "./models";
+import { isEngineSupported, probeServerEngine } from "./engines";
+import { preloadWhisperModel } from "./engines/localWhisper";
+import type { EngineId } from "./types";
+
+const ENGINE_INFO: Record<EngineId, { title: string; detail: string }> = {
+  local: {
+    title: "On this device (offline, private)",
+    detail:
+      "Runs a speech model inside your browser. After a one-time download it works with no internet, and your voice never leaves this device. Text appears when you pause.",
+  },
+  browser: {
+    title: "Browser speech recognition (needs internet)",
+    detail:
+      "Shows words as you speak. Your browser sends the audio to its maker's servers (Google for Chrome, Microsoft for Edge, Apple for Safari).",
+  },
+  server: {
+    title: "Panga server",
+    detail: "Sends audio to the Whisper server configured for this Panga deployment. Needs a connection to that server.",
+  },
+};
+
+export default function VoiceSettings() {
+  const prefs = useVoicePrefs();
+  const [serverOk, setServerOk] = useState(false);
+  const [dl, setDl] = useState<{ busy: boolean; progress: number | null; error: string | null }>({
+    busy: false,
+    progress: null,
+    error: null,
+  });
+
+  useEffect(() => {
+    void probeServerEngine().then(setServerOk);
+  }, []);
+
+  const engines: EngineId[] = serverOk ? ["local", "browser", "server"] : ["local", "browser"];
+  const model = WHISPER_MODELS[prefs.model];
+  const needsMultilingual = prefs.lang !== "en" && !model.multilingual;
+
+  async function download(key: WhisperModelKey) {
+    setDl({ busy: true, progress: null, error: null });
+    try {
+      await preloadWhisperModel(key, (p) => setDl({ busy: true, progress: p, error: null }));
+      setDl({ busy: false, progress: null, error: null });
+    } catch (e) {
+      setDl({ busy: false, progress: null, error: e instanceof Error ? e.message : "Download failed" });
+    }
+  }
+
+  return (
+    <section className="settings-section">
+      <h2>Voice Input</h2>
+      <p className="settings-help">
+        Click into any text box and press the mic that appears (or Alt+Shift+M) to dictate. Speech is inserted at your cursor
+        and never replaces what you've already written.
+      </p>
+
+      <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 14 }}>
+        {engines.map((id) => {
+          const supported = isEngineSupported(id);
+          return (
+            <label
+              key={id}
+              style={{
+                display: "flex",
+                gap: 10,
+                alignItems: "flex-start",
+                padding: "10px 12px",
+                border: "1px solid var(--color-border)",
+                borderRadius: "var(--radius)",
+                opacity: supported ? 1 : 0.55,
+                cursor: supported ? "pointer" : "not-allowed",
+              }}
+            >
+              <input
+                type="radio"
+                name="voice-engine"
+                checked={prefs.engine === id}
+                disabled={!supported}
+                onChange={() => setVoicePrefs({ engine: id })}
+                style={{ marginTop: 3 }}
+              />
+              <span>
+                <strong>{ENGINE_INFO[id].title}</strong>
+                {!supported && <em style={{ marginLeft: 6, fontSize: 12 }}>(not supported in this browser)</em>}
+                <span style={{ display: "block", fontSize: 12.5, color: "var(--color-text-muted)", marginTop: 2 }}>
+                  {ENGINE_INFO[id].detail}
+                </span>
+              </span>
+            </label>
+          );
+        })}
+      </div>
+

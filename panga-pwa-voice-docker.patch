index 0000000..1b7e08f
--- /dev/null
+++ b/src/voice/engines/whisper.worker.ts
@@ -0,0 +1,65 @@
+// Runs the Whisper speech model off the main thread so the UI never freezes.
+import { pipeline, env } from "@huggingface/transformers";
+
+type Msg =
+  | { type: "load"; repo: string }
+  | { type: "transcribe"; id: number; audio: Float32Array; language?: string };
+
+const ctx = self as unknown as {
+  postMessage(message: unknown): void;
+  onmessage: ((e: MessageEvent<Msg>) => void) | null;
+};
+
+// Serve the WebAssembly runtime from our own origin (see scripts/copy-ort.mjs)
+// instead of a public CDN. useWasmCache=false makes the runtime load straight
+// from these URLs, so the service worker (not a blob: import) caches them.
+function isOldSafari(): boolean {
+  const ua = navigator.userAgent;
+  if (!/Safari\//.test(ua) || /Chrome|Chromium|Edg|Android|OPR/.test(ua)) return false;
+  const m = /Version\/(\d+)/.exec(ua);
+  return !!m && Number(m[1]) < 26 && !("gpu" in navigator);
+}
+const suffix = isOldSafari() ? "" : ".asyncify";
+env.allowLocalModels = false;
+env.useWasmCache = false;
+const host = import.meta.env.VITE_MODEL_HOST as string | undefined;
+if (host) env.remoteHost = host.endsWith("/") ? host : host + "/";
+const onnxEnv = env.backends.onnx as unknown as { wasm: { wasmPaths: unknown } };
+onnxEnv.wasm.wasmPaths = {
+  mjs: `${self.location.origin}/ort/ort-wasm-simd-threaded${suffix}.mjs`,
+  wasm: `${self.location.origin}/ort/ort-wasm-simd-threaded${suffix}.wasm`,
+};
+
+let transcriber: any = null;
+let loadedRepo = "";
+
+ctx.onmessage = async (e) => {
+  const m = e.data;
+  try {
+    if (m.type === "load") {
+      if (!transcriber || loadedRepo !== m.repo) {
+        transcriber = null;
+        transcriber = await (pipeline as any)("automatic-speech-recognition", m.repo, {
+          device: "wasm",
+          dtype: "q8",
+          progress_callback: (p: unknown) => ctx.postMessage({ type: "progress", p }),
+        });
+        loadedRepo = m.repo;
+      }
+      ctx.postMessage({ type: "ready" });
+    } else if (m.type === "transcribe") {
+      if (!transcriber) throw new Error("Speech model is not loaded");
+      const out = await transcriber(m.audio, {
+        ...(m.language ? { language: m.language } : {}),
+        task: "transcribe",
+        chunk_length_s: 30,
+        return_timestamps: false,
+      });
+      const text = Array.isArray(out) ? out.map((o: { text: string }) => o.text).join(" ") : out.text;
+      ctx.postMessage({ type: "result", id: m.id, text });
+    }
+  } catch (err) {
+    const message = err instanceof Error ? err.message : String(err);
+    ctx.postMessage({ type: "error", id: m.type === "transcribe" ? m.id : undefined, message });
+  }
+};
diff --git a/src/voice/insertText.ts b/src/voice/insertText.ts
new file mode 100644
index 0000000..5b7f6fb
--- /dev/null
+++ b/src/voice/insertText.ts
@@ -0,0 +1,72 @@
+export type DictationTarget = HTMLInputElement | HTMLTextAreaElement;
+
+const CLOSING_PUNCT = /^[.,!?;:)\]}%…'"”’]/;
+const OPENING_CHAR = /[([{“‘"'\s]$/;
+
+/**
+ * Adds just enough spacing around dictated text so it neither glues onto the
+ * neighbouring words nor doubles up existing spaces.
+ */
+export function formatInsertion(before: string, after: string, text: string): string {
+  const t = text.trim();
+  if (!t) return "";
+  const lead = before.length > 0 && !OPENING_CHAR.test(before) && !CLOSING_PUNCT.test(t) ? " " : "";
+  const trail = after.length > 0 && !/^\s/.test(after) && !CLOSING_PUNCT.test(after) ? " " : "";
+  return lead + t + trail;
+}
+
+function setNativeValue(el: DictationTarget, value: string) {
+  // Going through the prototype setter (not el.value = ...) keeps React's
+  // internal value tracker unaware of the change, so the "input" event we
+  // dispatch next is seen as a real edit and fires the field's own onChange.
+  const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
+  const setter = Object.getOwnPropertyDescriptor(proto, "value")?.set;
+  if (setter) setter.call(el, value);
+  else el.value = value;
+}
+
+/**
+ * Inserts dictated text at the caret. It NEVER replaces existing text: if some
+ * text is selected, the dictation goes right after the selection and the
+ * selection is left behind it. The caret ends up after the inserted text, so
+ * consecutive phrases chain naturally.
+ *
+ * Returns false when nothing was inserted.
+ */
+export function insertAtCaret(el: DictationTarget, text: string): boolean {
+  if (el.disabled || el.readOnly) return false;
+
+  const value = el.value;
+  const caret = typeof el.selectionEnd === "number" ? el.selectionEnd : value.length;
+  const before = value.slice(0, caret);
+  const after = value.slice(caret);
+
+  let insert = formatInsertion(before, after, text);
+  if (!insert) return false;
+
+  if (el.maxLength > 0) {
+    const room = el.maxLength - value.length;
+    if (room <= 0) return false;
+    if (insert.length > room) insert = insert.slice(0, room);
+  }
+
+  setNativeValue(el, before + insert + after);
+  const pos = caret + insert.length;
+  try {
+    el.setSelectionRange(pos, pos);
+  } catch {
+    /* some input types do not support selection; value is still updated */
+  }
+  if (el instanceof HTMLTextAreaElement && pos === el.value.length) {
+    el.scrollTop = el.scrollHeight;
+  }
+
+  let evt: Event;
+  try {
+    evt = new InputEvent("input", { bubbles: true, inputType: "insertText", data: insert });
+  } catch {
+    evt = new Event("input", { bubbles: true });
+  }
+  el.dispatchEvent(evt);
+  return true;
+}
